# Reference only. Do not source/copy into a real .env or start services from this file.
# ../development.md explains consumers and unset/empty/optional behavior.
# Required by _load_settings; missing/blank fails. SQLAlchemy asyncpg DSN.
DATABASE_URL=
# Format only: postgresql+asyncpg://REPLACE_WITH_APPROVED_USER:REPLACE_WITH_APPROVED_PASSWORD@localhost:15432/REPLACE_WITH_APPROVED_DATABASE
# Separate guarded disposable DB only; not an app fallback or resource approval.
TEST_DATABASE_URL=
# Loader default is empty; contrary to its old comment, it has no required check.
AI_SERVICE_URL=http://localhost:9200
AI_REQUEST_TIMEOUT_SECONDS=90.0
# Blank Google credentials intentionally do not enable login/protected routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:3200/api/auth/callback
AUTH_ORIGINS=http://localhost:3200
CORS_ORIGINS=http://localhost:3200
# Source default false. Local 3200 HTTP exception requires an explicit later choice.
AUTH_ALLOW_LOCAL_HTTP=false
AUTH_SESSION_TTL_SECONDS=3600
# Only true requires all three Neo4j values during settings load.
ENABLE_NEWS_GRAPH=false
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Optional graph host URI: bolt://localhost:17687; container URI: bolt://neo4j:7687.
# Manual corp-code sync only; not required at app startup.
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
