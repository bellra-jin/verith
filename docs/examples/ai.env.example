# Reference only, never source/auto-copy. Empty keys do NOT make AI offline/safe.
# ../development.md covers consumer-specific defaults, aliases and model downloads.
# Supervisor/News missing, empty or whitespace falls back to localhost:8200.
BACKEND_BASE_URL=http://localhost:8200
# News optional token; blank -> None, not service authentication or API enablement.
BACKEND_AUTH_TOKEN=
# Technical needs key AND model; Flow uses a fixed code model, not OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=REPLACE_WITH_APPROVED_OPENAI_MODEL
# Flow/Technical require KIS settings at their respective call-time loaders.
KIS_API_KEY=
KIS_API_SECRET=
KIS_BASE_URL=https://replace-with-approved-kis.invalid
# Fundamental/Industry DART; optional until relevant collection calls.
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
# Fundamental optional master lookup, psycopg: postgresql://... not asyncpg.
# Keep blank; only a separately approved/verified minimum read-only credential.
VERITH_DB_URL=
# Do not inherit the Backend app DSN or its compatibility alias in this process.
# QWEN_API_KEY is an ENDPOINT URL, not a secret (News and Fundamental first alias).
QWEN_API_KEY=https://replace-with-approved-qwen.invalid/v1
# Fundamental second alias only; first alias above wins even when explicitly empty.
QWEN_BASE_URL=
QWEN_MODEL=REPLACE_WITH_APPROVED_QWEN_MODEL
LLM_DUMMY_KEY=REPLACE_WITH_APPROVED_LLM_KEY
# Industry: unset uses existing code defaults; explicit empty is not an off switch.
LLM_BASE_URL=https://replace-with-approved-llm.invalid/v1
LLM_MODEL=REPLACE_WITH_APPROVED_LLM_MODEL
LLM_API_KEY=
EMBED_MODEL=REPLACE_WITH_APPROVED_EMBED_MODEL
# Industry uses NEO4J_USERNAME, unlike Backend's NEO4J_USER; call-time required.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Technical optional cache; blank disables this factory, not the entire AI.
REDIS_URL=
# Host cache address shape: redis://localhost:16379/0 (authentication not provided).
# Host graph: bolt://localhost:17687; same Compose network: bolt://neo4j:7687.
